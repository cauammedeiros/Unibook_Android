<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_principal"
    tools:context=".CriarLivroActivity">

    <!-- Header Estilo Netflix -->
    <LinearLayout
        android:id="@+id/headerNetflix"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/voltar"
            android:src="@drawable/baseline_keyboard_arrow_left_24"
            android:padding="4dp"
            android:scaleType="fitCenter"
            app:tint="@color/cor_icones" />

        <TextView
            android:id="@+id/txtTituloEditar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/editar_livros"
            android:textColor="@color/texto_principal"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerNetflix">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <!-- Mensagem de Erro (IDs sincronizados com KT) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardErroCriarLivro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="#FFD2D2"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp">
                <TextView
                    android:id="@+id/txtErro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="Preencha nome, autor e a URL da capa."
                    android:textColor="#D32F2F"
                    android:textSize="14sp" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <!-- Capa do Livro -->
                <androidx.cardview.widget.CardView
                    android:layout_width="140dp"
                    android:layout_height="200dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/cor_card">
                    <ImageView
                        android:id="@+id/imgCapaLivro"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/logo_nome1" />
                </androidx.cardview.widget.CardView>

                <!-- Campos Nome, Autor, Gênero -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_nome"
                        android:textColor="@color/texto_secundario"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtNome"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/borda_edittext"
                        android:inputType="text"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/texto_principal"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/label_autor"
                        android:textColor="@color/texto_secundario"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtAutor"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/borda_edittext"
                        android:inputType="text"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/texto_principal"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/label_genero"
                        android:textColor="@color/texto_secundario"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtGenero"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/borda_edittext"
                        android:inputType="text"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/texto_principal"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Novo Campo: URL da Capa -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="URL da Imagem da Capa"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtUrlCapa"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/borda_edittext"
                android:hint="Cole aqui o link da imagem (http...)"
                android:inputType="textUri"
                android:paddingHorizontal="12dp"
                android:textColor="@color/texto_principal"
                android:textSize="14sp" />

            <!-- Sinopse -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/label_sinopse"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtSinopse"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/borda_edittext"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:textColor="@color/texto_principal"
                android:textSize="14sp" />

            <!-- Botão Criar (ID Sincronizado com KT) -->
            <Button
                android:id="@+id/btnRemover"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/btn_vermelho"
                android:text="Remover Livro"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnEditar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/btn_azul"
                android:text="Salvar Alterações"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</RelativeLayout>