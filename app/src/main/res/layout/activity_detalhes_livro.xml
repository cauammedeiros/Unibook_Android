<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    tools:context=".DetalhesLivroActivity">

    <!-- HEADER AZUL ESCURO -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        android:paddingHorizontal="8dp">

        <!-- Botão Voltar -->
        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/baseline_keyboard_arrow_left_24"
            android:contentDescription="Voltar"
            app:tint="@color/black" />

    </RelativeLayout>

    <!-- CONTEÚDO PRINCIPAL COM SCROLL -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- TÍTULO DO LIVRO -->
            <TextView
                android:id="@+id/txtNomeLivro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nome do Livro"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <!-- Linha divisória -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/cinza_borda"
                android:layout_marginBottom="16dp" />

            <!-- ÁREA DA CAPA E BOTÕES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- CAPA DO LIVRO -->
                <FrameLayout
                    android:layout_width="140dp"
                    android:layout_height="210dp"
                    android:background="@color/cinza_borda">

                    <ImageView
                        android:id="@+id/imgCapaLivro"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Capa do Livro" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Capa do Livro"
                        android:textColor="@color/texto_claro"
                        android:textSize="12sp" />
                </FrameLayout>

                <!-- BOTÕES À DIREITA -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <!-- Botão Baixar -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp">

                        <Button
                            android:id="@+id/btnBaixar"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_toStartOf="@+id/ic_baixar_ext"
                            android:layout_marginEnd="8dp"
                            android:text="Baixar"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:background="@drawable/btn_azul"
                            app:backgroundTint="@null"
                            android:textAllCaps="false"
                            android:gravity="center" />

                        <ImageView
                            android:id="@+id/ic_baixar_ext"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_download"
                            app:tint="@color/black" />
                    </RelativeLayout>

                    <!-- Botão Favoritar/Desfavoritar -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp">

                        <Button
                            android:id="@+id/btnFavoritar"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_toStartOf="@+id/ic_favoritar_ext"
                            android:layout_marginEnd="8dp"
                            android:text="Favoritar / Desfavoritar"
                            android:textColor="@color/black"
                            android:textSize="11sp"
                            android:background="@drawable/btn_branco_borda"
                            app:backgroundTint="@null"
                            android:textAllCaps="false"
                            android:gravity="center" />

                        <ImageView
                            android:id="@+id/ic_favoritar_ext"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_star_outline"
                            app:tint="@color/black" />
                    </RelativeLayout>

                    <!-- Botão Alugar/Empréstimo -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <Button
                            android:id="@+id/btnAlugar"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_toStartOf="@+id/ic_alugar_ext"
                            android:layout_marginEnd="8dp"
                            android:text="Alugar/Emprestimo"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            android:background="@drawable/btn_branco_borda"
                            app:backgroundTint="@null"
                            android:textAllCaps="false"
                            android:gravity="center" />

                        <ImageView
                            android:id="@+id/ic_alugar_ext"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_shopping_cart"
                            app:tint="@color/black" />
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- INFORMAÇÕES DO LIVRO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Gênero -->
                <EditText
                    android:id="@+id/txtGenero"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="Gênero :"
                    android:textSize="13sp"
                    android:textColorHint="@color/texto_claro"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/borda_edittext"
                    android:inputType="text"
                    android:layout_marginEnd="8dp" />

                <!-- Autor -->
                <EditText
                    android:id="@+id/txtAutor"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="Autor :"
                    android:textSize="13sp"
                    android:textColorHint="@color/texto_claro"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/borda_edittext"
                    android:inputType="text" />
            </LinearLayout>

            <!-- CAIXA DE SINOPSE -->
            <EditText
                android:id="@+id/txtSinopse"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:hint="Aqui vai ficar a Sinopse do Livro"
                android:textSize="13sp"
                android:textColorHint="@color/texto_claro"
                android:padding="12dp"
                android:background="@drawable/borda_edittext"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:scrollbars="vertical" />
        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="horizontal"
        android:paddingVertical="8dp"
        android:elevation="8dp">

        <!-- Início -->
        <LinearLayout
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home"
                app:tint="@color/black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Início"
                android:textColor="@color/black"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Biblioteca -->
        <LinearLayout
            android:id="@+id/navBiblioteca"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_library"
                app:tint="@color/black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Biblioteca"
                android:textColor="@color/black"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- CHATBOT -->
        <LinearLayout
            android:id="@+id/navChatbot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chatbot"
                app:tint="@color/black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHATBOT"
                android:textColor="@color/black"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Buscar -->
        <LinearLayout
            android:id="@+id/navBuscar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_search"
                app:tint="@color/black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buscar"
                android:textColor="@color/black"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Perfil -->
        <LinearLayout
            android:id="@+id/navPerfil"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_user_profile"
                app:tint="@color/black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perfil"
                android:textColor="@color/black"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
