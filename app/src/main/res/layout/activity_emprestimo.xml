<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_principal"
    tools:context=".EmprestimoActivity">

    <!-- Header Estilo Netflix -->
    <LinearLayout
        android:id="@+id/headerNetflix"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnVoltarTopo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voltar"
            android:src="@drawable/baseline_keyboard_arrow_left_24"
            android:padding="4dp"
            android:scaleType="fitCenter"
            app:tint="@color/cor_icones" />

        <TextView
            android:id="@+id/txtTituloEmprestimo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Empréstimo"
            android:textColor="@color/texto_principal"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerNetflix"
        android:layout_above="@id/bottomNavigation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="32dp">

            <!-- Card com Info do Livro -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/cor_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:id="@+id/imgCapaLivro"
                        android:layout_width="150dp"
                        android:layout_height="220dp"
                        android:layout_gravity="center"
                        android:scaleType="centerCrop"
                        android:src="@drawable/logo_nome1"
                        android:layout_marginBottom="24dp"
                        android:background="@color/cinza_borda"/>

                    <TextView
                        android:id="@+id/txtNomeLivro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Título do Livro"
                        android:textColor="@color/texto_principal"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/txtAutorLivro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Autor do Livro"
                        android:textColor="@color/texto_secundario"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:layout_marginBottom="24dp"/>

                    <!-- Datas -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_data_entrega"
                            android:textColor="@color/texto_secundario"
                            android:textSize="14sp" />
                        <TextView
                            android:id="@+id/txtDataEntrega"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="10/07/2023"
                            android:textColor="@color/texto_principal"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:gravity="end"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_data_devolucao"
                            android:textColor="@color/texto_secundario"
                            android:textSize="14sp" />
                        <TextView
                            android:id="@+id/txtDataDevolucao"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="24/07/2023"
                            android:textColor="@color/texto_principal"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:gravity="end"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="24dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_status_v2"
                            android:textColor="@color/texto_secundario"
                            android:textSize="14sp" />
                        <TextView
                            android:id="@+id/txtStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Disponível"
                            android:textColor="@color/azul_botao"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:gravity="end"/>
                    </LinearLayout>

                    <!-- Termos -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <CheckBox
                            android:id="@+id/checkTermos"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:button="@null"
                            android:background="@drawable/selector_checkbox_termos"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:id="@+id/btnAceitarTermos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/btn_aceitar_termos_v2"
                            android:textColor="@color/texto_principal"
                            android:textSize="14sp"
                            android:clickable="true"
                            android:focusable="true"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtErroTermos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/err_aceitar_termos"
                        android:textColor="@color/vermelho_botao"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Botões -->
            <Button
                android:id="@+id/btnConfirmar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/btn_azul"
                app:backgroundTint="@null"
                android:text="@string/btn_confirmar"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnVoltar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_cinza_borda"
                app:backgroundTint="@null"
                android:text="@string/voltar"
                android:textAllCaps="false"
                android:textColor="@color/texto_principal" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/bottomNavigation"
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />

</RelativeLayout>