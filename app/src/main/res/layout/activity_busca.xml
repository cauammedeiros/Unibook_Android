<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_principal"
    tools:context=".BuscaActivity">

    <!-- Header Estilo Netflix -->
    <LinearLayout
        android:id="@+id/headerNetflix"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/txtTituloBusca"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Buscar"
            android:textColor="@color/texto_principal"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnTema"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_light_mode"
            android:padding="4dp"
            app:tint="@color/cor_icones"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/desc_alternar_tema"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Barra de Busca Fixa abaixo do Header -->
    <LinearLayout
        android:id="@+id/searchContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerNetflix"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <EditText
                android:id="@+id/edtBusca"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/borda_edittext"
                android:hint="Encontre livros, autores ou gêneros"
                android:paddingStart="16dp"
                android:paddingEnd="48dp"
                android:textColor="@color/texto_principal"
                android:textColorHint="@color/texto_secundario"
                android:textSize="14sp"
                android:singleLine="true" />

            <ImageView
                android:id="@+id/btnLupa"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_search"
                app:tint="@color/cor_icones" />
        </FrameLayout>
    </LinearLayout>

    <!-- Conteúdo Scrollable -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/searchContainer"
        android:layout_above="@+id/layout_bottom_nav_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <!-- Título da Seção -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:text="Explorar Gêneros"
                android:textColor="@color/texto_principal"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Lista de Gêneros -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView android:id="@+id/genRomance" style="@style/ItemGenero" android:text="Romance" />
                <TextView style="@style/ItemGenero" android:text="Fantasia" />
                <TextView style="@style/ItemGenero" android:text="Ficção Científica" />
                <TextView style="@style/ItemGenero" android:text="Mistério/Suspense" />
                <TextView style="@style/ItemGenero" android:text="Terror (Horror)" />
                <TextView style="@style/ItemGenero" android:text="Aventura" />
                <TextView style="@style/ItemGenero" android:text="Drama" />
                <TextView style="@style/ItemGenero" android:text="Biografia / Autobiografia" />
                <TextView style="@style/ItemGenero" android:text="História" />
                <TextView style="@style/ItemGenero" android:text="Autoajuda" />
                <TextView style="@style/ItemGenero" android:text="Educacional / Didático" />
                <TextView style="@style/ItemGenero" android:text="Ciência / Divulgação Científica" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Container para o Bottom Navigation -->
    <LinearLayout
        android:id="@+id/layout_bottom_nav_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <include layout="@layout/layout_bottom_nav" />
    </LinearLayout>

</RelativeLayout>