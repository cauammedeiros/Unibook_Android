<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/cor_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Capa do Livro com cantos arredondados -->
            <androidx.cardview.widget.CardView
                android:layout_width="100dp"
                android:layout_height="145dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/fundo_principal">

                <ImageView
                    android:id="@+id/imgCapaBusca"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/logo_nome1" />
            </androidx.cardview.widget.CardView>

            <!-- Informações Principais -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtTituloBusca"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texto_principal"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:maxLines="2"
                    tools:text="Título do Livro" />

                <TextView
                    android:id="@+id/txtAutorBusca"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/texto_secundario"
                    android:textSize="14sp"
                    tools:text="Autor do Livro" />

                <TextView
                    android:id="@+id/txtGeneroBusca"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/borda_edittext"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/cor_primaria"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Mistério" />

            </LinearLayout>
        </LinearLayout>

        <!-- Divisor Sutil -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="@color/cor_borda" />

        <!-- Sinopse -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sinopse"
            android:textColor="@color/texto_principal"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSinopseBusca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/texto_secundario"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            tools:text="Aqui será exibida a descrição detalhada do livro selecionado nos filtros da busca..." />

    </LinearLayout>
</androidx.cardview.widget.CardView>