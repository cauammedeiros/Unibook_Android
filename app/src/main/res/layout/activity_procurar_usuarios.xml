<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_principal"
    tools:context=".ProcurarUsuariosActivity">

    <!-- Header Estilo Netflix -->
    <LinearLayout
        android:id="@+id/headerNetflix"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/voltar"
            android:src="@drawable/baseline_keyboard_arrow_left_24"
            android:padding="4dp"
            android:scaleType="fitCenter"
            app:tint="@color/cor_icones" />

        <TextView
            android:id="@+id/txtTituloProcurarUsuarios"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_procurar_usuarios"
            android:textColor="@color/texto_principal"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnTema"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_light_mode"
            android:padding="4dp"
            app:tint="@color/cor_icones"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/desc_alternar_tema"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Barra de Busca Padronizada (Altura 56dp) -->
    <LinearLayout
        android:id="@+id/searchContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerNetflix"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/borda_edittext">

            <ImageView
                android:id="@+id/icSearchIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:src="@drawable/ic_search"
                app:tint="@color/cor_icones"
                android:contentDescription="@string/hint_busca" />

            <EditText
                android:id="@+id/edtBuscaUsuarios"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toEndOf="@id/icSearchIcon"
                android:background="@android:color/transparent"
                android:hint="@string/hint_busca"
                android:textColorHint="@color/texto_secundario"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:textColor="@color/texto_principal"
                android:textSize="15sp"
                android:singleLine="true"
                android:imeOptions="actionSearch" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Lista de Usuários -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvUsuarios"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/searchContainer"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="20dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_usuario_lista" />

</RelativeLayout>