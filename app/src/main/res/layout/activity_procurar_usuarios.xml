<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ProcurarUsuariosActivity">

    <!-- Header -->
    <ImageView
        android:id="@+id/btnVoltar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:contentDescription="@string/voltar"
        android:src="@drawable/baseline_keyboard_arrow_left_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/black" />

    <TextView
        android:id="@+id/txtTituloProcurarUsuarios"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_procurar_usuarios"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/btnVoltar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnVoltar" />

    <View
        android:id="@+id/dividerProcurarUsuarios"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="#CCCCCC"
        app:layout_constraintTop_toBottomOf="@+id/txtTituloProcurarUsuarios" />

    <!-- Search Bar -->
    <EditText
        android:id="@+id/edtBuscaUsuarios"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_margin="16dp"
        android:autofillHints="name"
        android:background="@drawable/borda_edittext"
        android:drawableEnd="@drawable/ic_search"
        android:hint="@string/hint_busca"
        android:inputType="text"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@+id/dividerProcurarUsuarios" />

