<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fundo_principal"
    tools:context=".ChatbotActivity">

    <!-- Header Estilo Netflix -->
    <LinearLayout
        android:id="@+id/headerNetflix"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/txtTituloChat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Chatbot"
            android:textColor="@color/texto_principal"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnTema"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="20dp"
            android:src="@drawable/ic_light_mode"
            android:padding="4dp"
            app:tint="@color/cor_icones"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/desc_alternar_tema"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/btnBuscarTop"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_search"
            android:contentDescription="@string/nav_buscar"
            app:tint="@color/cor_icones" />
    </LinearLayout>

    <!-- Área de Chat -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/chatScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Mensagem do Usuário -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_message_user"
                android:padding="12dp"
                android:text="Certo, quero um livro sobre culinária!"
                android:textColor="@color/texto_principal" />

            <!-- Marcador e Resposta CHATBOT -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHATBOT"
                android:textColor="@color/texto_secundario"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_message_bot"
                android:padding="12dp"
                android:text="Certo! Aqui vai um dos resultados para livros sobre culinária!"
                android:textColor="@color/texto_principal" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Campo de Entrada -->
    <LinearLayout
        android:id="@+id/inputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@color/fundo_principal">

        <EditText
            android:id="@+id/editPergunta"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/borda_edittext"
            android:hint="Pergunte sobre algum livro"
            android:paddingHorizontal="16dp"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_secundario"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnEnviar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:rotation="180"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/cor_icones" />
    </LinearLayout>

    <!-- Menu Inferior -->
    <include
        android:id="@+id/bottomNavigationInclude"
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>