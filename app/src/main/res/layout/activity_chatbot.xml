<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    tools:context=".ChatbotActivity">

    <!-- 1. Cabeçalho (Fixo no topo) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="197dp"
            android:layout_height="100dp"
            android:src="@drawable/logo_nome"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btnSun"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="20dp"
            android:src="@drawable/ic_light_mode"
            app:layout_constraintBottom_toBottomOf="@+id/imgLogo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/imgLogo" />

        <ImageView
            android:id="@+id/btnMoon"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/ic_dark_mode"
            app:layout_constraintEnd_toEndOf="@+id/btnSun"
            app:layout_constraintTop_toBottomOf="@+id/btnSun" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. Área de Chat (Expansível) -->
    <!-- O layout_weight="1" faz o chat ocupar todo o espaço central sobrando -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/chatScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Mensagem do Usuário -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginBottom="16dp"
                android:background="#F0F0F0"
                android:padding="12dp"
                android:text="Certo, quero um livro sobre culinária!"
                android:textColor="@color/black" />

            <!-- Marcador e Resposta CHATBOT -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHATBOT"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="#E3F2FD"
                android:padding="12dp"
                android:text="Certo! Aqui vai um dos resultados para livros sobre culinária!"
                android:textColor="@color/black" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 3. Campo de Entrada (Fixo acima do menu) -->
    <LinearLayout
        android:id="@+id/inputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@color/white">

        <EditText
            android:id="@+id/editPergunta"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/borda_edittext"
            android:hint="Pergunte sobre algum livro"
            android:paddingHorizontal="16dp"
            android:textSize="14sp" />

        <ImageButton
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="#D1C4E9"
            android:rotation="180"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#4A148C" />
    </LinearLayout>

    <!-- 4. Menu Inferior (Sempre na base) -->
    <include
        android:id="@+id/bottomNavigation"
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>