<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_principal"
    tools:context=".VerificarMultasActivity">

    <!-- Header Estilo Netflix -->
    <LinearLayout
        android:id="@+id/headerNetflix"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voltar"
            android:src="@drawable/baseline_keyboard_arrow_left_24"
            android:padding="4dp"
            android:scaleType="fitCenter"
            app:tint="@color/cor_icones" />

        <TextView
            android:id="@+id/txtTituloMultas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_multas"
            android:textColor="@color/texto_principal"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Campo de Busca Estilizado -->
    <LinearLayout
        android:id="@+id/searchContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerNetflix"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/edtBusca"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/borda_edittext"
                android:hint="@string/hint_busca_multas"
                android:textColorHint="@color/texto_secundario"
                android:paddingStart="16dp"
                android:paddingEnd="48dp"
                android:textColor="@color/texto_principal"
                android:textSize="14sp"
                android:singleLine="true" />

            <ImageView
                android:id="@+id/btn_pesquisar_multa"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_search"
                app:tint="@color/cor_icones" />
        </FrameLayout>
    </LinearLayout>

    <!-- Lista de Multas -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMultas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/searchContainer"
        android:layout_above="@+id/layout_bottom_nav_container"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="80dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_multa" />

    <!-- Container para o Bottom Navigation -->

</RelativeLayout>