<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_principal"
    tools:context=".RecuperacaoActivity">

    <!-- Header Estilo Netflix -->
    <LinearLayout
        android:id="@+id/headerNetflix"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnVoltarRecuperar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/voltar"
            android:src="@drawable/baseline_keyboard_arrow_left_24"
            android:padding="4dp"
            android:scaleType="fitCenter"
            app:tint="@color/cor_icones" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_recuperar_senha"
            android:textColor="@color/texto_principal"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnTema"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_light_mode"
            android:padding="4dp"
            app:tint="@color/cor_icones"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/desc_alternar_tema"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerNetflix"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingBottom="32dp">

            <ImageView
                android:id="@+id/logo4"
                android:layout_width="240dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/logo_nome1" />

            <TextView
                android:id="@+id/txtEsqueceu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/esqueceu_a_senha"
                android:textColor="@color/texto_principal"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtInforme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/label_informe_email"
                android:textColor="@color/texto_secundario"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/txtEmail2"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/borda_edittext"
                android:hint="@string/hint_email_exemplo"
                android:textColorHint="@color/texto_secundario"
                android:textColor="@color/texto_principal"
                android:paddingHorizontal="16dp"
                android:inputType="textEmailAddress"
                android:singleLine="true" />

            <Button
                android:id="@+id/btnSolicitar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/btn_azul"
                app:backgroundTint="@null"
                android:text="@string/btn_solicitar"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtErroRecuperacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/fundo_erro"
                android:padding="12dp"
                android:text="@string/msg_erro_email_inexistente"
                android:textColor="@color/erro_texto"
                android:gravity="center"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="40dp" />

            <TextView
                android:id="@+id/txtTermos3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/termos"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp"
                android:alpha="0.7" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</RelativeLayout>