<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_item_lista_arredondado"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Ícone de Perfil -->
    <ImageView
        android:id="@+id/imgPerfilUsuario"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginStart="8dp"
        android:contentDescription="Perfil do usuário"
        android:src="@drawable/ic_profile_1" />

    <!-- Informações da Multa -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Nome do Usuário -->
        <TextView
            android:id="@+id/txtNomeUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_multa_text_pill"
            android:gravity="center"
            android:minWidth="160dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="1dp"
            android:text="Nome do Usuário 1"
            android:textColor="@color/black"
            android:textSize="13sp" />

        <!-- Valor da Multa -->
        <TextView
            android:id="@+id/txtValorMulta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_multa_text_pill"
            android:gravity="center"
            android:minWidth="140dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="1dp"
            android:text="Valor da multa: R$"
            android:textColor="@color/black"
            android:textSize="13sp" />

        <!-- Livro Atrasado -->
        <TextView
            android:id="@+id/txtLivroAtrasado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_multa_text_pill"
            android:gravity="center"
            android:minWidth="180dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="1dp"
            android:text="Livro atrasado há 2 dias"
            android:textColor="@color/black"
            android:textSize="13sp" />

        <!-- Status -->
        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_multa_text_pill"
            android:gravity="center"
            android:minWidth="170dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="1dp"
            android:text="Status: Pago/Não Pago"
            android:textColor="@color/black"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>