<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="@color/white"
    android:clickable="true"
    android:focusable="true">

    <!-- Ícone de Perfil -->
    <ImageView
        android:id="@+id/imgPerfilUsuario"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_user_profile"
        android:contentDescription="Perfil do usuário" />

    <!-- Informações da Multa -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:orientation="vertical">

        <!-- Nome do Usuário -->
        <TextView
            android:id="@+id/txtNomeUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nome do Usuário 1"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="4dp" />

        <!-- Valor da Multa -->
        <TextView
            android:id="@+id/txtValorMulta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Valor da multa: R$"
            android:textSize="13sp"
            android:textColor="@color/texto_escuro"
            android:layout_marginBottom="2dp" />

        <!-- Livro Atrasado -->
        <TextView
            android:id="@+id/txtLivroAtrasado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Livro atrasado há 2 dias"
            android:textSize="13sp"
            android:textColor="@color/texto_escuro"
            android:layout_marginBottom="2dp" />

        <!-- Status -->
        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Pago/Não Pago"
            android:textSize="13sp"
            android:textColor="@color/texto_escuro" />
    </LinearLayout>

</LinearLayout>