<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardBackgroundColor="@color/cor_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alterar Capa do Livro"
            android:textColor="@color/texto_principal"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cole abaixo o link da nova imagem:"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/edtUrlDialog"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/borda_edittext"
            android:hint="https://link-da-imagem.com/foto.jpg"
            android:inputType="textUri"
            android:paddingHorizontal="12dp"
            android:textColor="@color/texto_principal"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnConfirmarUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/btn_azul"
            app:backgroundTint="@null"
            android:text="@string/btn_confirmar"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCancelarUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_cinza_borda"
            app:backgroundTint="@null"
            android:text="@string/voltar"
            android:textAllCaps="false"
            android:textColor="@color/texto_principal"
            android:textSize="16sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>