<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardBackgroundColor="@color/cor_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Termos de Serviço"
            android:textColor="@color/texto_principal"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Para realizar o empréstimo, você deve aceitar os termos de uso da biblioteca."
            android:textColor="@color/texto_secundario"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/checkAceitar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Eu aceito os termos"
            android:textColor="@color/texto_principal"
            android:buttonTint="@color/azul_botao"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnConfirmarBaixar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/btn_azul"
            app:backgroundTint="@null"
            android:text="Confirmar"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVoltar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_cinza_borda"
            app:backgroundTint="@null"
            android:text="@string/voltar"
            android:textAllCaps="false"
            android:textColor="@color/texto_principal"
            android:textSize="16sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>