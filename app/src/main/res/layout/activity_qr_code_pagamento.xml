<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".QrCodePagamentoActivity">

    <!-- Header com botão voltar -->
    <ImageView
        android:id="@+id/btnVoltar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/baseline_keyboard_arrow_left_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/black" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnVoltar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- QR Code com borda grossa e arredondada (fundo_qrcode.xml) -->
            <FrameLayout
                android:layout_width="250dp"
                android:layout_height="250dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/fundo_qrcode">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="QrCode"
                    android:textColor="@color/black"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Campo Código do copie e cole -->
            <TextView
                android:id="@+id/txtCodigoCopiaCola"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:background="@drawable/btn_branco_borda"
                android:paddingHorizontal="24dp"
                android:paddingVertical="10dp"
                android:text="Código do copie e cole"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <!-- Botão Copiar Código -->
            <Button
                android:id="@+id/btnCopiarCodigo"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="#5B7FFF"
                android:text="Copiar Código"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:cornerRadius="12dp" />

            <!-- Campo Valor da Multa -->
            <TextView
                android:id="@+id/txtLabelValorMulta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_gravity="start"
                android:background="@drawable/btn_branco_borda"
                android:paddingHorizontal="24dp"
                android:paddingVertical="10dp"
                android:text="Valor da Multa :"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <!-- Campo Status -->
            <TextView
                android:id="@+id/txtLabelStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_gravity="start"
                android:background="@drawable/btn_branco_borda"
                android:paddingHorizontal="24dp"
                android:paddingVertical="10dp"
                android:text="Status :"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <!-- Aviso Rodapé em Card Centralizado -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:background="@drawable/btn_branco_borda"
                android:gravity="center"
                android:padding="20dp"
                android:text="Após realizar o pagamento,\nenvie o comprovante via imagem."
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>